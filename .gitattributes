# Force LF for files that run inside Linux (scripts, units, container files),
# so clones made on Windows still work when copied to a Pi or into Docker.
*.sh               text eol=lf
*.go               text eol=lf
*.service          text eol=lf
*.template         text eol=lf
Dockerfile         text eol=lf
*.yml              text eol=lf
.env.example       text eol=lf
*.png              binary
