# Force LF for files that run on Linux (scripts, units, config templates),
# so clones made on Windows still work when copied to a Pi.
*.sh               text eol=lf
*.go               text eol=lf
*.service          text eol=lf
*.template         text eol=lf
*.nft              text eol=lf
.env.example       text eol=lf
*.png              binary
