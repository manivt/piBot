# ==============================================================================
# piBot Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# Telegram Bot Configuration
# 1. Create a bot via @BotFather on Telegram (https://t.me/BotFather) to get your token.
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram numeric user IDs permitted to interact with piBot.
# Find your numeric ID via @userinfobot (https://t.me/userinfobot).
# Messages from users not in this list will be ignored.
TELEGRAM_ALLOWED_USERS=123456789

# Appliance host configuration
# APPLIANCE_USER defaults to current $USER if unset.
APPLIANCE_USER=

# The name your bot calls itself (default: piBot). Set it to the display name
# you chose in BotFather, e.g. BOT_NAME="Bob", then rerun ./scripts/setup.sh.
BOT_NAME="piBot"

# WORKSPACE_ROOT defaults to $HOME/workspaces if unset.
WORKSPACE_ROOT=

# Port for the agy-shim loopback HTTP bridge (default: 8088). Always bound to 127.0.0.1.
# Its access token is generated by scripts/setup.sh; you don't need to set one here.
AGY_SHIM_PORT=8088

# LAN guard firewall (default: on). Blocks the bot's user account from reaching
# other devices on your local network; internet, DNS and SSH into the Pi still
# work. Note it also blocks LAN connections you start from that account.
LAN_GUARD=on
