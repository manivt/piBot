[Unit]
Description=piBot Antigravity Shim
After=network-online.target pibot-lan-guard.service
Wants=network-online.target pibot-lan-guard.service

[Service]
Type=simple
User=__APPLIANCE_USER__
WorkingDirectory=__WORKSPACE_ROOT__
Environment="PATH=/usr/local/bin:/usr/bin:/bin:__HOME__/.local/bin"
# Provides AGY_SHIM_TOKEN and AGY_SHIM_PORT (generated by scripts/setup.sh, mode 0600)
EnvironmentFile=__SHIM_ENV_FILE__
ExecStart=__WORKSPACE_ROOT__/agy-shim/agy-shim
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
